{
  "name": "Lead Scraper Automation",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Start Scrape (Manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scraper-results",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-receive",
      "name": "Receive Scraper Results",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 650],
      "webhookId": "REPLACE_AFTER_ACTIVATION"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_VPS_IP:8000/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Scraper-Token", "value": "YOUR_SECRET_TOKEN" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"callback_url\": $node[\"Receive Scraper Results\"].json[\"webhookUrl\"] } }}",
        "options": {}
      },
      "id": "trigger-scrape",
      "name": "Trigger Scrape on VPS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-status",
      "name": "Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 650]
    },
    {
      "parameters": {
        "fromEmail": "you@yourdomain.com",
        "toEmail": "you@yourdomain.com",
        "subject": "Lead scrape finished - CSV attached",
        "text": "The scraper finished successfully. Results CSV is attached.",
        "options": { "attachments": "file" }
      },
      "id": "send-email",
      "name": "Email Results",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [700, 550]
    },
    {
      "parameters": {
        "fromEmail": "you@yourdomain.com",
        "toEmail": "you@yourdomain.com",
        "subject": "Lead scrape FAILED",
        "text": "=The scrape failed. Reason: {{ $json.reason }}",
        "options": {}
      },
      "id": "notify-failure",
      "name": "Notify Failure",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [700, 750]
    },
    {
      "parameters": {
        "content": "## Setup checklist\n\n1. Import this workflow and click **Activate**.\n2. Open 'Receive Scraper Results' node → copy the **Production Webhook URL**.\n3. In 'Trigger Scrape on VPS' node:\n   - Replace `YOUR_VPS_IP` with your server's public IP\n   - Replace `YOUR_SECRET_TOKEN` with the token you set as `SCRAPER_TOKEN` on the VPS\n4. In 'Email Results' / 'Notify Failure' nodes, set your real email address and connect an Email credential (SMTP/Gmail).\n5. On the VPS, make sure `server.py` is running (`python3 server.py`) with `SCRAPER_TOKEN` exported and port 8000 open.\n6. Click 'Start Scrape (Manual)' to run.\n\nNeeds: scraper_playwright.py + server.py running on your VPS (from earlier in this chat).",
        "height": 400,
        "width": 380
      },
      "id": "sticky-instructions",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [950, 300]
    }
  ],
  "connections": {
    "Start Scrape (Manual)": {
      "main": [[{ "node": "Trigger Scrape on VPS", "type": "main", "index": 0 }]]
    },
    "Receive Scraper Results": {
      "main": [[{ "node": "Succeeded?", "type": "main", "index": 0 }]]
    },
    "Succeeded?": {
      "main": [
        [{ "node": "Email Results", "type": "main", "index": 0 }],
        [{ "node": "Notify Failure", "type": "main", "index": 0 }]
      ]
    }
  }
}
